# Web / API ports
CAMREC_WEB_PORT=8080
CAMREC_API_PORT=8000
OPENLIST_PORT=5244
TZ=Asia/Shanghai

# Application
CAMREC_APP_NAME=Camera Recorder
CAMREC_DEBUG=false
# IMPORTANT: keep this value stable after cameras have been added, otherwise
# existing encrypted camera passwords can no longer be decrypted.
CAMREC_SECRET_KEY=replace-with-a-long-random-secret

# Recording
CAMREC_SEGMENT_DURATION_SECONDS=600
CAMREC_REMUX_CONCURRENCY=2
CAMREC_RTSP_TIMEOUT_US=5000000
CAMREC_AUTO_START_ENABLED=true
CAMREC_ALIGN_SEGMENTS_TO_CLOCK=true

# Storage health thresholds
CAMREC_STORAGE_WARNING_PERCENT=80
CAMREC_STORAGE_CRITICAL_PERCENT=90

# 115 / OpenList upload
# First start OpenList, mount the 115 Open Platform driver at path "115",
# then set CAMREC_UPLOAD_ENABLED=true and restart the backend.
CAMREC_UPLOAD_ENABLED=false
CAMREC_UPLOAD_CONCURRENCY=2
CAMREC_UPLOAD_RETRY_MAX=8
CAMREC_WEBDAV_ROOT=监控录像
CAMREC_LOCAL_RETENTION_HOURS=48
OPENLIST_ADMIN_PASSWORD=replace-with-a-strong-openlist-password
# Normally keep root in Docker Desktop. On Linux you may set host UID/GID.
OPENLIST_UID=0
OPENLIST_GID=0

# Local development binaries. Docker supplies its own current FFmpeg build.
CAMREC_FFMPEG_BIN=ffmpeg
CAMREC_FFPROBE_BIN=ffprobe
