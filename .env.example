# Web / API ports
CAMREC_WEB_PORT=8080
CAMREC_API_PORT=8000
TZ=Asia/Shanghai

# Application
CAMREC_APP_NAME=Camera Recorder
CAMREC_DEBUG=false
# Change this before exposing the service outside a trusted LAN.
CAMREC_SECRET_KEY=replace-with-a-long-random-secret

# Recording
CAMREC_SEGMENT_DURATION_SECONDS=600
CAMREC_REMUX_CONCURRENCY=2
CAMREC_UPLOAD_CONCURRENCY=2
CAMREC_RTSP_TIMEOUT_US=5000000
CAMREC_AUTO_START_ENABLED=true
CAMREC_ALIGN_SEGMENTS_TO_CLOCK=true

# Local development binaries. Docker supplies its own current FFmpeg build.
CAMREC_FFMPEG_BIN=ffmpeg
CAMREC_FFPROBE_BIN=ffprobe
