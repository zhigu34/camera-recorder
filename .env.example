# Host ports / timezone
CAMREC_WEB_PORT=8080
OPENLIST_PORT=5244
TZ=Asia/Shanghai

# Encryption key used for camera/SMTP/WebDAV secrets stored in SQLite.
# IMPORTANT: keep this value stable after first use.
CAMREC_SECRET_KEY=replace-with-a-long-random-secret

# OpenList container bootstrap only. Camera Recorder's WebDAV credentials,
# upload switch and retention policy are configured later in the Web UI.
OPENLIST_ADMIN_PASSWORD=replace-with-a-strong-openlist-password
OPENLIST_UID=0
OPENLIST_GID=0
